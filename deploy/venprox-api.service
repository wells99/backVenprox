[Unit]
Description=Venprox API
After=network-online.target
[Service]
Type=simple
User=venprox
WorkingDirectory=/opt/venprox/backend
Environment=NODE_ENV=production
ExecStart=/opt/node24/bin/node --use-system-ca --env-file=/etc/venprox/api.env dist/apps/api/src/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/venprox
UMask=0077
[Install]
WantedBy=multi-user.target
